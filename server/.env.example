# Port the Express server listens on
PORT=4000

# Origin of the Vite dev server (frontend) - must match exactly for CORS + cookies
CLIENT_ORIGIN=http://localhost:5175

# Secret used to sign the session cookie. Change this for any real deployment.
SESSION_SECRET=change-me-to-a-long-random-string

# Public RPC endpoint for Ethereum Sepolia testnet (no API key required)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain ID the SIWE messages must be signed for (Sepolia = 11155111)
CHAIN_ID=11155111

# A well-known ERC-20 deployed on Sepolia used for the on-chain balance read.
# Default: Chainlink test LINK token on Sepolia.
ERC20_ADDRESS=0x779877A7B0D9E8603169DdbD7836e478b4624789

# MySQL (users, linked accounts and sessions are stored here). Tables are created on start.
MYSQL_URL=mysql://root@127.0.0.1:3306/mudra

# GitHub OAuth (optional): create an OAuth App at github.com/settings/developers.
# Callback URL must equal GITHUB_REDIRECT_URI. Leave empty to disable the link feature (the API answers 501).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/oauth/github/callback
