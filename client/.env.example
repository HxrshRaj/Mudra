# URL of the Mudra backend (see server/.env.example)
VITE_API_URL=http://localhost:4000

# Public RPC endpoint the frontend uses directly (independent of MetaMask's
# own provider) to fetch the live native ETH balance.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain the app expects the wallet to be connected to (Sepolia = 11155111)
VITE_CHAIN_ID=11155111
